# --- Docker Compose: Postgres container ---
# The db container creates this user and database on first start.
# The app container builds its DATABASE_URL from these three values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dispo

# --- Database (local run without Docker, scripts and tests) ---
# Docker Postgres is published on port 5433, a local Postgres usually runs on 5432.
DATABASE_URL=postgresql://postgres:password@localhost:5433/dispo

TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/dispo_test

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First admin, created by scripts/seed.py ---
ADMIN_EMAIL=admin@dispo.local
ADMIN_PASSWORD=

# --- CORS ---
# The origin must match exactly: localhost and 127.0.0.1 are different origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
